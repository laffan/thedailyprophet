{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Capabilities for the main library/reader webview",
  "webviews": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "icloud-folder:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://**" }, { "url": "http://**" }]
    },
    "allow-list-documents",
    "allow-get-document",
    "allow-get-document-html",
    "allow-save-state",
    "allow-rename-document",
    "allow-delete-document",
    "allow-platform",
    "allow-export-document",
    "allow-import-document",
    "allow-render-annotations",
    "allow-export-annotations",
    "allow-get-settings",
    "allow-set-settings",
    "allow-sync-now",
    "allow-default-sync-folder",
    "allow-capture-start",
    "allow-capture-control",
    "allow-capture-set-bounds",
    "allow-edit-set-removals",
    "allow-edit-clear-removals",
    "allow-capture-archive-open-existing",
    "allow-capture-archive-commit"
  ]
}
