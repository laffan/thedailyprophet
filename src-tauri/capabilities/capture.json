{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "capture-remote",
  "description": "Grants pages loaded in the embedded capture webview access to exactly the capture_* reporting commands, so the injected toolkit can report progress and deliver snapshots. All of these commands treat their caller as untrusted.",
  "webviews": ["capture"],
  "remote": {
    "urls": ["https://*", "http://*"]
  },
  "local": false,
  "permissions": [
    "allow-capture-page-info",
    "allow-capture-progress",
    "allow-capture-count",
    "allow-capture-included",
    "allow-capture-fetch",
    "allow-capture-deliver",
    "allow-capture-failed",
    "allow-capture-archive-begin",
    "allow-capture-archive-resource",
    "allow-capture-archive-finish",
    "allow-capture-archive-open-existing",
    "allow-capture-archive-commit"
  ]
}
